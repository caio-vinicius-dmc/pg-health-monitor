# cp .env.example .env
# Ambiente local. Nenhum destes valores serve para produção.

POSTGRES_USER=monitor
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=aplicacao
POSTGRES_HOST=localhost
POSTGRES_PORT=15438

# Para apontar o monitor para outro banco, basta mudar as variáveis acima.
# O usuário precisa apenas de leitura e da role pg_read_all_stats.
